meta {
  name: Aceptar Documento
  type: http
  seq: 3
  tags: [
    Consentimiento
  ]
}

post {
  url: {{API_URL}}{{API_PREFIX}}/aceptacion-documento
  body: json
  auth: bearer
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "id_documento": 0,
    "dispositivo": ""
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

example {
  name: 201 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/aceptacion-documento
    method: POST
    mode: json
    body:json: {
      {
        "id_documento": 0,
        "dispositivo": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

example {
  name: 422 Response
  description: Validation Error
  
  request: {
    url: {{baseUrl}}/api/aceptacion-documento
    method: POST
    mode: json
    body:json: {
      {
        "id_documento": 0,
        "dispositivo": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": [
            {
              "loc": [],
              "msg": "",
              "type": "",
              "input": "",
              "ctx": {}
            }
          ]
        }
      '''
    }
  }
}
