meta {
  name: Has Accepted
  type: http
  seq: 2
  tags: [
    Consentimiento
  ]
}

get {
  url: {{API_URL}}{{API_PREFIX}}/aceptacion-documento/estado
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/aceptacion-documento/estado
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "accepted": false
        }
      '''
    }
  }
}
