meta {
  name: Get Documento Activo
  type: http
  seq: 1
  tags: [
    Consentimiento
  ]
}

get {
  url: {{API_URL}}{{API_PREFIX}}/aceptacion-documento/activo
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

example {
  name: 200 Response
  description: Successful Response
  
  request: {
    url: {{baseUrl}}/api/aceptacion-documento/activo
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id_documento": 0,
          "version": "",
          "contenido": "",
          "fecha_publicacion": ""
        }
      '''
    }
  }
}
