meta {
  name: [IPS-MOCK] Put Reprogramar Cita IPS
  type: http
  seq: 10
}

put {
  url: {{API_URL}}{{API_PREFIX}}/instituciones/{{ID_INSTITUCION}}/citas/{{ID_CITA}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

docs {
  [IPS-MOCK] Este endpoint reprograma la cita en la IPS mock configurada para la institución.
}

body:json {
  {
    "nueva_fecha_hora_cupo": "{{FECHA_HORA_REPROGRAMACION}}"
  }
}
