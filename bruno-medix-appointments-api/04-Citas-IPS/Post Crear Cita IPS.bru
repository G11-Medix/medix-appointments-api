meta {
  name: Post Crear Cita IPS
  type: http
  seq: 7
}

post {
  url: {{API_URL}}{{API_PREFIX}}/instituciones/{{ID_INSTITUCION}}/citas/
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:json {
  {
    "id_paciente": {{ID_PACIENTE_IPS}},
    "id_prestador": {{ID_PRESTADOR}},
    "fecha_hora_cupo": "{{FECHA_HORA_CITA}}"
  }
}
