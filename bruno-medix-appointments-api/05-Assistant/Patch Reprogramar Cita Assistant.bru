meta {
  name: Patch Reprogramar Cita Assistant
  type: http
  seq: 19
}

patch {
  url: {{API_URL}}{{API_PREFIX}}/citas/{{ID_CITA}}/reprogramar
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:json {
  {
    "id_institucion": {{ID_INSTITUCION}},
    "id_especialidad": {{ID_ESPECIALIDAD}},
    "nueva_fecha": "{{NUEVA_FECHA_CITA_ASSISTANT}}",
    "nueva_hora": "{{NUEVA_HORA_CITA_ASSISTANT}}"
  }
}
