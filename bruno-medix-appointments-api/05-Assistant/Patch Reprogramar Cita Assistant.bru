meta {
  name: [IPS-MOCK] Patch Reprogramar Cita Assistant
  type: http
  seq: 19
}

patch {
  url: {{API_URL}}{{API_PREFIX}}/citas/{{ID_CITA}}/reprogramar
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

docs {
  [IPS-MOCK] Este endpoint reprograma la cita a través de la IPS mock configurada para la institución.
}

body:json {
  {
    "id_institucion": {{ID_INSTITUCION}},
    "codigo_reps": {{CODIGO_REPS}},
    "nueva_fecha": "{{NUEVA_FECHA_CITA_ASSISTANT}}",
    "nueva_hora": "{{NUEVA_HORA_CITA_ASSISTANT}}"
  }
}
