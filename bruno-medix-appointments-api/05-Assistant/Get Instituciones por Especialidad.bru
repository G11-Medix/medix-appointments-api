meta {
  name: [IPS-MOCK] Get Instituciones por Especialidad
  type: http
  seq: 15
}

get {
  url: {{API_URL}}{{API_PREFIX}}/instituciones/?codigo_reps={{CODIGO_REPS}}&id_paciente={{ID_PACIENTE}}
  body: none
  auth: none
}

params:query {
  codigo_reps: {{CODIGO_REPS}}
  id_paciente: {{ID_PACIENTE}}
}

headers {
