meta {
  name: Put Actualizar Recomendacion
  type: http
  seq: 4
}

put {
  url: {{API_URL}}{{API_PREFIX}}/recomendaciones/{{ID_RECOMENDACION}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:json {
  {
    "codigo": "CARDIO-PREP-ACTUALIZADA",
    "recomendaciones": {
      "items": [
        "Llegar 30 minutos antes",
        "Traer documento de identidad",
        "Evitar ejercicio intenso antes de la cita si aplica"
      ]
    },
    "prioridad": 2,
    "activa": true
  }
}
