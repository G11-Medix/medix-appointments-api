meta {
  name: Post Crear Recomendacion
  type: http
  seq: 3
}

post {
  url: {{API_URL}}{{API_PREFIX}}/recomendaciones/
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:json {
  {
    "institucion_id": {{ID_INSTITUCION}},
    "especialidad_id": {{ID_ESPECIALIDAD}},
    "codigo": "CARDIO-PREP",
    "recomendaciones": {
      "items": [
        "Llegar 20 minutos antes",
        "Traer documento de identidad",
        "Traer orden medica o historia clinica si aplica"
      ]
    },
    "prioridad": 1,
    "activa": true
  }
}
